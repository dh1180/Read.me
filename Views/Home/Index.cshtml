@model ReadMeApp.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "대시보드";
}

<!-- Modern Hero Banner -->
<div class="hero-banner p-4 p-md-5 mb-5 text-white">
    <div class="col-lg-8 position-relative" style="z-index: 2;">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="hero-pill px-3 py-1">
                <i class="bi bi-terminal-fill me-1 text-info"></i> Read.me Journal
            </span>
            <span class="badge bg-white bg-opacity-10 text-light rounded-pill px-3 py-1 fw-normal">ASP.NET Core &amp; Azure</span>
        </div>
        <h1 class="display-6 fw-bold mb-3 tracking-tight">개발자를 위한 스마트 독서 저널</h1>
        <p class="lead text-light text-opacity-75 mb-4 fs-6" style="max-width: 620px;">
            책 속 인상 깊은 구절을 마크다운으로 기록하고 독서 진행률을 추적하세요. 
            내 독서 기록을 <strong>GitHub Profile README.md</strong> 형식으로 원클릭 추출할 수 있습니다.
        </p>
        <div class="d-flex flex-wrap gap-3">
            <button type="button" class="btn btn-primary-gradient px-4 py-2" data-bs-toggle="modal" data-bs-target="#searchModal">
                <i class="bi bi-search me-1"></i> 새 도서 검색 &amp; 추가
            </button>
            <a asp-controller="Books" asp-action="Index" class="btn btn-glass px-4 py-2">
                <i class="bi bi-collection me-1"></i> 내 서재 바로가기
            </a>
            <button type="button" class="btn btn-glass px-4 py-2" id="btnExportReadmeHero">
                <i class="bi bi-markdown-fill me-1 text-warning"></i> README 내보내기
            </button>
        </div>
    </div>
</div>

<!-- Key Stat Metric Cards -->
<div class="row g-4 mb-5">
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold d-block mb-1">읽는 중인 도서</span>
                    <h2 class="fw-bold mb-0 text-dark">@Model.ReadingCount<span class="fs-6 text-muted fw-normal ms-1">권</span></h2>
                </div>
                <div class="metric-icon-bubble" style="background: #eef2ff; color: #6366f1;">
                    <i class="bi bi-book-half"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold d-block mb-1">완독한 도서</span>
                    <h2 class="fw-bold mb-0 text-dark">@Model.CompletedCount<span class="fs-6 text-muted fw-normal ms-1">권</span></h2>
                </div>
                <div class="metric-icon-bubble" style="background: #ecfdf5; color: #10b981;">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold d-block mb-1">읽고 싶은 책</span>
                    <h2 class="fw-bold mb-0 text-dark">@Model.WishlistCount<span class="fs-6 text-muted fw-normal ms-1">권</span></h2>
                </div>
                <div class="metric-icon-bubble" style="background: #fffbeb; color: #f59e0b;">
                    <i class="bi bi-bookmark-star-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold d-block mb-1">기록한 필사 &amp; 메모</span>
                    <h2 class="fw-bold mb-0 text-dark">@Model.TotalNotesCount<span class="fs-6 text-muted fw-normal ms-1">개</span></h2>
                </div>
                <div class="metric-icon-bubble" style="background: #ecfeff; color: #06b6d4;">
                    <i class="bi bi-pencil-square"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Yearly Goal Progress Bar -->
<div class="card border-0 shadow-sm p-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-1"><i class="bi bi-flag-fill"></i> 목표</span>
            <span class="fw-bold text-dark">올해 독서 목표 달성률</span>
        </div>
        <span class="fw-bold text-secondary small">
            @Model.CompletedCount / @Model.YearlyGoal 권 
            <span class="text-primary ms-1">(@Model.GoalProgressPercentage%)</span>
        </span>
    </div>
    <div class="progress" style="height: 10px;">
        <div class="progress-bar" role="progressbar" 
             style="width: @Model.GoalProgressPercentage%;" 
             aria-valuenow="@Model.GoalProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Currently Reading -->
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-hourglass-split text-primary me-1"></i> 지금 읽고 있는 책
            </h5>
            <a asp-controller="Books" asp-action="Index" asp-route-status="Reading" class="text-decoration-none small text-muted">
                전체보기 <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (Model.CurrentlyReading.Count == 0)
        {
            <div class="card border-0 shadow-sm text-center py-5">
                <div class="card-body">
                    <i class="bi bi-book text-muted opacity-50" style="font-size: 3rem;"></i>
                    <h6 class="fw-bold text-secondary mt-3">현재 읽고 있는 책이 없습니다</h6>
                    <p class="text-muted small mb-3">상단 검색 버튼을 눌러 새 책을 추가해 보세요.</p>
                    <button type="button" class="btn btn-primary-gradient btn-sm px-3" data-bs-toggle="modal" data-bs-target="#searchModal">
                        <i class="bi bi-plus-lg me-1"></i> 책 추가하기
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var item in Model.CurrentlyReading)
                {
                    <div class="card border-0 shadow-sm p-3 hover-shadow transition" id="card-userbook-@item.Id">
                        <div class="row g-3 align-items-center">
                            <div class="col-3 col-sm-2 text-center">
                                @if (!string.IsNullOrWhiteSpace(item.Book?.CoverImageUrl))
                                {
                                    <img src="@item.Book.CoverImageUrl" alt="@item.Book.Title" class="shelf-book-cover img-fluid" style="max-height: 110px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-light text-secondary rounded d-flex align-items-center justify-content-center" style="height: 100px;">
                                        <i class="bi bi-book fs-2"></i>
                                    </div>
                                }
                            </div>
                            <div class="col-9 col-sm-10">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h6 class="fw-bold mb-0 text-truncate" style="max-width: 80%;">
                                        <a asp-controller="Books" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                            @item.Book?.Title
                                        </a>
                                    </h6>
                                    <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle small px-2">읽는 중</span>
                                </div>
                                <p class="text-muted small mb-2 text-truncate">@item.Book?.Author | @item.Book?.Publisher</p>

                                <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                                    <span>진행률: <strong class="text-primary" id="pct-text-@item.Id">@item.ProgressPercentage%</strong></span>
                                    <span><span id="curr-page-text-@item.Id">@item.CurrentPage</span> / @item.Book?.TotalPages p</span>
                                </div>
                                <div class="progress mb-3" style="height: 6px;">
                                    <div class="progress-bar" id="progress-bar-@item.Id" role="progressbar" style="width: @item.ProgressPercentage%;"></div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="input-group input-group-sm" style="max-width: 200px;">
                                        <span class="input-group-text bg-light text-muted small">p.</span>
                                        <input type="number" class="form-control" id="input-quick-page-@item.Id" value="@item.CurrentPage" min="0" max="@item.Book?.TotalPages" />
                                        <button class="btn btn-outline-primary btn-quick-save" data-id="@item.Id" type="button">저장</button>
                                    </div>
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@item.Id" class="btn btn-light btn-sm text-secondary px-2">
                                        메모 쓰기 <i class="bi bi-chevron-right small"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Right Column: Recent Notes & Thoughts -->
    <div class="col-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-chat-square-quote text-info me-1"></i> 최근 필사 &amp; 메모
            </h5>
        </div>

        @if (Model.RecentNotes.Count == 0)
        {
            <div class="card border-0 shadow-sm text-center py-5">
                <div class="card-body">
                    <i class="bi bi-chat-quote text-muted opacity-50" style="font-size: 3rem;"></i>
                    <h6 class="fw-bold text-secondary mt-3">기록된 메모가 없습니다</h6>
                    <p class="text-muted small mb-0">책을 읽으며 기억하고 싶은 문장을 기록해 보세요.</p>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var note in Model.RecentNotes)
                {
                    <div class="card border-0 shadow-sm p-3 hover-shadow transition" style="border-left: 4px solid var(--primary) !important;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold small text-dark text-truncate" style="max-width: 75%;">
                                <i class="bi bi-book me-1 text-primary"></i> @note.UserBook?.Book?.Title
                            </span>
                            <span class="badge bg-light text-secondary border small">p.@note.PageNumber</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(note.Quote))
                        {
                            <blockquote class="blockquote small text-secondary fst-italic my-2 ps-2 border-start border-2 border-primary">
                                "@note.Quote"
                            </blockquote>
                        }
                        <div class="markdown-preview small text-dark mt-1">
                            @Html.Raw(note.ThoughtHtml)
                        </div>
                        <div class="text-muted text-end small mt-2" style="font-size: 0.75rem;">
                            <i class="bi bi-clock me-1"></i>@note.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
