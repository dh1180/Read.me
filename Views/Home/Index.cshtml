@model ReadMeApp.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "모두의 독서록";
    var currentSort = Model.CurrentSort ?? "latest";
}

<!-- Warm Community Hero Banner -->
<div class="hero-banner p-4 p-md-5 mb-4 text-white">
    <div class="col-lg-8 position-relative" style="z-index: 2;">
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="hero-pill px-3 py-1">
                <i class="bi bi-book-half me-1 text-warning"></i> 모두의 독서록 (Read.me)
            </span>
            <span class="badge bg-white bg-opacity-10 text-light rounded-pill px-3 py-1 fw-normal">열린 독서 커뮤니티</span>
        </div>
        <h1 class="display-6 fw-bold mb-3 tracking-tight">우리가 읽고 나눈 이야기</h1>
        <p class="lead text-light text-opacity-75 mb-4 fs-6" style="max-width: 620px;">
            사람들이 책을 읽고 남긴 솔직한 독서록과 마음에 남은 한 문장을 만나보세요. 
            진행률 계산의 번거로움 없이, 읽고 느낀 생각을 가장 편하게 기록할 수 있습니다.
        </p>
        <div class="d-flex flex-wrap gap-3">
            <button type="button" class="btn btn-primary-gradient px-4 py-2" data-bs-toggle="modal" data-bs-target="#writeReviewModal">
                <i class="bi bi-pencil-square me-1"></i> 독서록 작성하기
            </button>
            <a asp-controller="Books" asp-action="Index" class="btn btn-glass px-4 py-2">
                <i class="bi bi-collection me-1"></i> 서재 둘러보기
            </a>
            <button type="button" class="btn btn-glass px-4 py-2" id="btnExportReadmeHero">
                <i class="bi bi-markdown-fill me-1 text-warning"></i> 독서록 내보내기
            </button>
        </div>
    </div>
</div>

<!-- Community Stats & Filter Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
    <!-- Sort & Tabs -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="text-muted small fw-semibold me-1"><i class="bi bi-filter"></i> 정렬:</span>
        <a asp-action="Index" asp-route-sort="latest" asp-route-query="@Model.SearchQuery" 
           class="btn btn-sm rounded-pill px-3 @(currentSort == "latest" ? "btn-primary" : "btn-light text-secondary")">
            <i class="bi bi-clock-history me-1"></i> 최신순
        </a>
        <a asp-action="Index" asp-route-sort="popular" asp-route-query="@Model.SearchQuery" 
           class="btn btn-sm rounded-pill px-3 @(currentSort == "popular" ? "btn-primary" : "btn-light text-secondary")">
            <i class="bi bi-fire me-1"></i> 인기순
        </a>
        <a asp-action="Index" asp-route-sort="rating" asp-route-query="@Model.SearchQuery" 
           class="btn btn-sm rounded-pill px-3 @(currentSort == "rating" ? "btn-primary" : "btn-light text-secondary")">
            <i class="bi bi-star-fill text-warning me-1"></i> 별점순
        </a>
    </div>

    <!-- Search Form -->
    <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 360px;">
        <input type="hidden" name="sort" value="@currentSort" />
        <div class="input-group input-group-sm">
            <input type="text" name="query" class="form-control rounded-start-pill ps-3" 
                   placeholder="도서명, 저자, 서평 검색..." value="@Model.SearchQuery" />
            <button class="btn btn-primary rounded-end-pill px-3" type="submit">
                <i class="bi bi-search"></i>
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
        {
            <a asp-action="Index" asp-route-sort="@currentSort" class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="초기화">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </form>
</div>

<!-- Community Book Reviews Feed -->
@if (Model.Reviews.Count == 0)
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <i class="bi bi-journal-x text-muted opacity-50" style="font-size: 3.5rem;"></i>
            <h5 class="fw-bold mt-3 text-secondary">
                @(string.IsNullOrWhiteSpace(Model.SearchQuery) ? "작성된 독서록이 아직 없습니다" : $"'{Model.SearchQuery}'에 대한 검색 결과가 없습니다")
            </h5>
            <p class="text-muted small mb-3">책을 읽고 느낀 생각을 첫 번째 독서록으로 남겨보세요!</p>
            <button type="button" class="btn btn-primary-gradient px-4 py-2" data-bs-toggle="modal" data-bs-target="#writeReviewModal">
                <i class="bi bi-pencil-square me-1"></i> 독서록 작성하기
            </button>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-4">
        @foreach (var review in Model.Reviews)
        {
            <div class="col" id="review-card-@review.Id">
                <div class="card h-100 border-0 shadow-sm hover-shadow transition p-4 d-flex flex-column" style="border-radius: 16px;">
                    <!-- Review Header: Reviewer Info + Rating -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-light text-primary d-flex align-items-center justify-content-center border" style="width: 38px; height: 38px;">
                                <i class="bi bi-person-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.95rem;">@review.ReviewerName</h6>
                                <span class="text-muted small" style="font-size: 0.78rem;">
                                    <i class="bi bi-calendar3 me-1"></i>@review.ReadDate.ToString("yyyy.MM.dd") 완독
                                </span>
                            </div>
                        </div>

                        <!-- Star Rating -->
                        <div class="d-flex align-items-center gap-1">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= review.Rating)
                                {
                                    <i class="bi bi-star-fill text-warning" style="font-size: 0.95rem;"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-black-50 opacity-25" style="font-size: 0.95rem;"></i>
                                }
                            }
                            <span class="badge bg-warning-subtle text-dark fw-bold ms-1" style="font-size: 0.75rem;">@review.Rating.0</span>
                        </div>
                    </div>

                    <!-- Book Mini Info Box -->
                    <div class="d-flex gap-3 align-items-center p-3 mb-3 bg-light rounded-3 border border-light">
                        <div class="flex-shrink-0 text-center" style="width: 58px;">
                            @if (!string.IsNullOrWhiteSpace(review.Book?.CoverImageUrl))
                            {
                                <img src="@review.Book.CoverImageUrl" alt="@review.Book.Title" class="shelf-book-cover img-fluid rounded" style="max-height: 80px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-secondary bg-opacity-25 rounded d-flex align-items-center justify-content-center" style="height: 80px;">
                                    <i class="bi bi-book text-muted"></i>
                                </div>
                            }
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <h6 class="fw-bold mb-1 text-truncate text-dark" title="@review.Book?.Title">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@review.Id" class="text-decoration-none text-dark">
                                    @review.Book?.Title
                                </a>
                            </h6>
                            <p class="text-muted small mb-0 text-truncate">
                                @(review.Book?.Author ?? "저자 미상") · @(review.Book?.Publisher ?? "")
                            </p>
                        </div>
                    </div>

                    <!-- Memorable Quote Box (if exists) -->
                    @if (!string.IsNullOrWhiteSpace(review.Quote))
                    {
                        <div class="quote-callout mb-3 p-3 rounded-3 position-relative" style="background: #fafafa; border-left: 4px solid var(--primary);">
                            <i class="bi bi-quote text-primary opacity-50 fs-4 position-absolute" style="top: -6px; left: 6px;"></i>
                            <p class="mb-0 small fst-italic text-secondary ps-3" style="line-height: 1.6;">
                                "@review.Quote"
                            </p>
                        </div>
                    }

                    <!-- Summary & Review Content -->
                    <div class="mb-3 flex-grow-1">
                        @if (!string.IsNullOrWhiteSpace(review.Summary))
                        {
                            <h6 class="fw-bold text-dark mb-2" style="font-size: 1rem; line-height: 1.4;">
                                @review.Summary
                            </h6>
                        }
                        <p class="text-secondary small mb-0" style="white-space: pre-line; line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden;">
                            @review.Content
                        </p>
                    </div>

                    <!-- Card Footer: Likes & Detail Link -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 btn-like-review" data-id="@review.Id">
                            <i class="bi bi-heart-fill me-1"></i>
                            좋아요 <strong class="like-count" id="like-count-@review.Id">@review.LikesCount</strong>
                        </button>

                        <a asp-controller="Books" asp-action="Details" asp-route-id="@review.Id" class="btn btn-light btn-sm text-secondary rounded-pill px-3">
                            독서록 전문 보기 <i class="bi bi-chevron-right small"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

