@model ReadMeApp.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "모두의 독서록";
    var currentSort = Model.CurrentSort ?? "latest";
}

<!-- Clean Modern Black & Purple Hero Banner -->
<div class="hero-banner p-4 p-md-5 mb-4 text-white rounded-4 shadow-sm">
    <div class="col-lg-8 position-relative" style="z-index: 2;">
        <div class="d-inline-flex align-items-center gap-2 mb-3 px-3 py-1 rounded-pill hero-pill small">
            <i class="bi bi-book-half" style="color: #c4b5fd;"></i>
            <span class="text-white fw-medium">열린 독서 커뮤니티 · Read.me</span>
        </div>
        <h1 class="display-6 fw-bold mb-3 tracking-tight text-white">우리가 읽고 나눈 이야기</h1>
        <p class="lead text-light text-opacity-75 mb-4 fs-6" style="max-width: 580px; line-height: 1.7;">
            책을 읽고 마음속에 남은 솔직한 생각과 밑줄 친 문장을 편하게 기록하고 나눠보세요.
            템플릿을 활용해 누구나 1분 만에 완성도 높은 독서록을 작성할 수 있습니다.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Books" asp-action="Create" class="btn btn-primary-gradient px-4 py-2 rounded-pill shadow-sm fw-semibold">
                <i class="bi bi-pencil-square me-1"></i> 독서록 작성하기
            </a>
            <a asp-controller="Books" asp-action="Index" class="btn btn-glass px-4 py-2 rounded-pill">
                <i class="bi bi-collection me-1"></i> 서재 둘러보기
            </a>
        </div>
    </div>
</div>

<!-- Community Stats & Filter Bar -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-2 border-bottom">
    <!-- Sort & Tabs -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="text-muted small fw-semibold me-1"><i class="bi bi-filter"></i> 정렬:</span>
        <a asp-action="Index" asp-route-sort="latest" asp-route-query="@Model.SearchQuery" 
           class="btn btn-sm rounded-pill px-3 @(currentSort == "latest" ? "btn-primary" : "btn-light text-secondary border")">
            <i class="bi bi-clock-history me-1"></i> 최신순
        </a>
        <a asp-action="Index" asp-route-sort="popular" asp-route-query="@Model.SearchQuery" 
           class="btn btn-sm rounded-pill px-3 @(currentSort == "popular" ? "btn-primary" : "btn-light text-secondary border")">
            <i class="bi bi-fire me-1"></i> 인기순
        </a>
        <a asp-action="Index" asp-route-sort="rating" asp-route-query="@Model.SearchQuery" 
           class="btn btn-sm rounded-pill px-3 @(currentSort == "rating" ? "btn-primary" : "btn-light text-secondary border")">
            <i class="bi bi-star-fill me-1"></i> 별점순
        </a>
    </div>

    <!-- Search Form -->
    <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 340px;">
        <input type="hidden" name="sort" value="@currentSort" />
        <div class="input-group input-group-sm">
            <input type="text" name="query" class="form-control rounded-start-pill ps-3" 
                   placeholder="도서명, 저자, 서평 검색..." value="@Model.SearchQuery" />
            <button class="btn btn-primary rounded-end-pill px-3" type="submit">
                <i class="bi bi-search"></i>
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
        {
            <a asp-action="Index" asp-route-sort="@currentSort" class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="초기화">
                <i class="bi bi-x-lg"></i>
            </a>
        }
    </form>
</div>

<!-- Community Book Reviews Feed -->
@if (Model.Reviews.Count == 0)
{
    <div class="card border-0 shadow-sm text-center py-5 rounded-4" style="background: #ffffff; border: 1px solid #edf0f5 !important;">
        <div class="card-body py-5">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 68px; height: 68px; background: #f5f3ff; border: 1px solid #ede9fe;">
                <i class="bi bi-journal-plus fs-2" style="color: #7c3aed;"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">
                @(string.IsNullOrWhiteSpace(Model.SearchQuery) ? "작성된 독서록이 아직 없습니다" : $"'{Model.SearchQuery}'에 대한 검색 결과가 없습니다")
            </h5>
            <p class="text-muted small mb-4" style="max-width: 420px; margin: 0 auto;">
                내가 읽은 책의 소중한 생각과 밑줄 친 문장을 첫 번째로 기록하고 사람들과 공유해 보세요.
            </p>
            <a asp-controller="Books" asp-action="Create" class="btn btn-primary-gradient px-4 py-2 rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-pencil-square me-1"></i> 첫 독서록 작성하기
            </a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-4">
        @foreach (var review in Model.Reviews)
        {
            <div class="col" id="review-card-@review.Id">
                <div class="card h-100 border-0 shadow-sm hover-shadow transition p-4 d-flex flex-column rounded-4" style="background: #ffffff; border: 1px solid #edf0f5 !important;">
                    <!-- 1. Header: Reviewer & Rating -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle d-flex align-items-center justify-content-center border" style="width: 36px; height: 36px; font-weight: 600; background: #f5f3ff; color: #7c3aed; border-color: #ede9fe !important;">
                                @(string.IsNullOrEmpty(review.ReviewerName) ? "독" : review.ReviewerName[..1])
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">@review.ReviewerName</div>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    @review.ReadDate.ToString("yyyy.MM.dd") 완독
                                </div>
                            </div>
                        </div>

                        <!-- Star Rating Badge -->
                        <div class="d-flex align-items-center gap-1 px-2 py-1 rounded-pill" style="background: #f5f3ff; color: #7c3aed;">
                            <i class="bi bi-star-fill small" style="color: #7c3aed;"></i>
                            <span class="fw-bold small" style="font-size: 0.78rem;">@review.Rating.0</span>
                        </div>
                    </div>

                    <!-- 2. Clean Book Row -->
                    <div class="d-flex gap-3 align-items-center p-2 mb-3 rounded-3 bg-light bg-opacity-50 border border-light">
                        <div class="flex-shrink-0" style="width: 46px; height: 64px;">
                            @if (!string.IsNullOrWhiteSpace(review.Book?.CoverImageUrl))
                            {
                                <img src="@review.Book.CoverImageUrl" alt="@review.Book.Title" 
                                     class="img-fluid rounded shadow-sm w-100 h-100" style="object-fit: cover;"
                                     onerror="this.onerror=null; this.src='https://via.placeholder.com/46x64?text=Book';" />
                            }
                            else
                            {
                                <div class="bg-secondary bg-opacity-25 rounded d-flex align-items-center justify-content-center w-100 h-100 text-muted">
                                    <i class="bi bi-book"></i>
                                </div>
                            }
                        </div>
                        <div class="flex-grow-1 min-w-0">
                            <h6 class="fw-bold mb-1 text-truncate text-dark" style="font-size: 0.95rem;">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@review.Id" class="text-decoration-none text-dark hover-primary">
                                    @(review.Book?.Title ?? "도서 정보 없음")
                                </a>
                            </h6>
                            <div class="text-muted small text-truncate" style="font-size: 0.78rem;">
                                @(review.Book?.Author ?? "저자 미상") @(!string.IsNullOrWhiteSpace(review.Book?.Publisher) ? "· " + review.Book.Publisher : "")
                            </div>
                        </div>
                    </div>

                    <!-- 3. Memorable Quote (clean minimal purple accent line) -->
                    @if (!string.IsNullOrWhiteSpace(review.Quote))
                    {
                        <div class="ps-3 py-1 my-2 border-start border-3 fst-italic text-secondary small" style="border-color: #7c3aed !important; line-height: 1.6;">
                            "@review.Quote"
                        </div>
                    }

                    <!-- 4. Review Title & Content -->
                    <div class="mb-3 flex-grow-1">
                        @if (!string.IsNullOrWhiteSpace(review.Summary))
                        {
                            <h6 class="fw-bold text-dark mb-2" style="font-size: 1.05rem; line-height: 1.4;">
                                @review.Summary
                            </h6>
                        }
                        <p class="text-secondary small mb-0" style="white-space: pre-line; line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @review.Content
                        </p>
                    </div>

                    <!-- 5. Footer: Likes & Detail Link -->
                    <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                        <button type="button" class="btn btn-sm btn-light rounded-pill px-3 text-secondary btn-like-review" data-id="@review.Id">
                            <i class="bi bi-heart text-danger me-1"></i>
                            <span class="like-count" id="like-count-@review.Id">@review.LikesCount</span>
                        </button>

                        <a asp-controller="Books" asp-action="Details" asp-route-id="@review.Id" class="text-decoration-none small fw-semibold d-inline-flex align-items-center gap-1" style="color: #7c3aed;">
                            독서록 읽기 <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
