@model ReadMeApp.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "모두의 독서록";
    var currentSort = Model.CurrentSort ?? "latest";
}

<section class="hero-banner p-4 p-md-5 mb-4 text-white rounded-4">
    <div class="row align-items-center g-4 position-relative" style="z-index: 2;">
        <div class="col-lg-8">
            <div class="d-inline-flex align-items-center gap-2 mb-3 px-3 py-1 rounded-pill hero-pill small">
                <i class="bi bi-book-half"></i>
                <span>책을 읽고, 기억하고, 함께 나누는 곳</span>
            </div>
            <h1 class="display-6 fw-bold mb-3 text-white">읽은 책의 이야기를 오래 남겨보세요.</h1>
            <p class="mb-4 hero-description">
                책 속에서 마음에 남은 문장, 한 줄 평, 천천히 정리한 감상을 한곳에 기록하고
                다른 사람의 독서 경험도 편하게 둘러볼 수 있습니다.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Books" asp-action="Create" class="btn btn-primary-gradient px-4 py-2 rounded-pill fw-semibold">
                    <i class="bi bi-pencil-square me-1"></i> 내 독서록 쓰기
                </a>
                <button type="button" class="btn btn-glass px-4 py-2 rounded-pill" data-bs-toggle="modal" data-bs-target="#searchModal">
                    <i class="bi bi-search me-1"></i> 읽을 책 찾기
                </button>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="hero-stats-card">
                <div>
                    <span class="hero-stat-number">@Model.TotalReviewsCount</span>
                    <span class="hero-stat-label">개의 독서록</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div>
                    <span class="hero-stat-number">@Model.TotalBooksCount</span>
                    <span class="hero-stat-label">권의 책</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="feed-toolbar mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
        <div>
            <h2 class="h5 fw-bold mb-1">모두의 독서 기록</h2>
            <p class="text-muted small mb-0">
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <span>'@Model.SearchQuery' 검색 결과 @(Model.FilteredReviewsCount)개</span>
                }
                else
                {
                    <span>다른 독자들이 남긴 최근 기록을 만나보세요.</span>
                }
            </p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <a asp-action="Index" asp-route-sort="latest" asp-route-query="@Model.SearchQuery"
               class="btn btn-sm rounded-pill px-3 @(currentSort == "latest" ? "btn-primary" : "btn-soft")">최신순</a>
            <a asp-action="Index" asp-route-sort="popular" asp-route-query="@Model.SearchQuery"
               class="btn btn-sm rounded-pill px-3 @(currentSort == "popular" ? "btn-primary" : "btn-soft")">공감순</a>
            <a asp-action="Index" asp-route-sort="rating" asp-route-query="@Model.SearchQuery"
               class="btn btn-sm rounded-pill px-3 @(currentSort == "rating" ? "btn-primary" : "btn-soft")">별점순</a>
        </div>
    </div>

    <form asp-action="Index" method="get" class="mt-3">
        <input type="hidden" name="sort" value="@currentSort" />
        <div class="input-group feed-search">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" name="query" class="form-control border-start-0 ps-0"
                   placeholder="책 제목, 저자, 독서록 내용으로 검색해 보세요" value="@Model.SearchQuery" />
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a asp-action="Index" asp-route-sort="@currentSort" class="btn btn-outline-secondary">초기화</a>
            }
            <button class="btn btn-primary px-4" type="submit">검색</button>
        </div>
    </form>
</section>

@if (Model.Reviews.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-journal-bookmark"></i></div>
        <h3 class="h5 fw-bold">아직 보여드릴 독서록이 없어요.</h3>
        <p class="text-muted mb-4">첫 번째 독서 기록을 남겨 새로운 이야기를 시작해 보세요.</p>
        <a asp-controller="Books" asp-action="Create" class="btn btn-primary rounded-pill px-4">독서록 작성하기</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-4">
        @foreach (var review in Model.Reviews)
        {
            <div class="col">
                <article class="card reading-card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="reader-avatar">@(string.IsNullOrEmpty(review.ReviewerName) ? "독" : review.ReviewerName[..1])</div>
                                <div>
                                    <div class="fw-semibold small">@review.ReviewerName</div>
                                    <div class="text-muted" style="font-size: .76rem;">@review.ReadDate.ToString("yyyy.MM.dd")</div>
                                </div>
                            </div>
                            <div class="rating-chip"><i class="bi bi-star-fill"></i> @review.Rating.0</div>
                        </div>

                        <div class="d-flex gap-3 align-items-center book-summary-row mb-3">
                            <div class="feed-cover">
                                @if (!string.IsNullOrWhiteSpace(review.Book?.CoverImageUrl))
                                {
                                    <img src="@review.Book.CoverImageUrl" alt="@review.Book.Title" />
                                }
                                else
                                {
                                    <span><i class="bi bi-book"></i></span>
                                }
                            </div>
                            <div class="min-w-0">
                                <h3 class="h6 fw-bold mb-1 text-truncate">
                                    <a asp-controller="Books" asp-action="Details" asp-route-id="@review.Id" class="text-decoration-none text-dark">
                                        @(review.Book?.Title ?? "도서 정보 없음")
                                    </a>
                                </h3>
                                <p class="text-muted small mb-0 text-truncate">@(review.Book?.Author ?? "저자 미상")</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(review.Quote))
                        {
                            <blockquote class="feed-quote">“@review.Quote”</blockquote>
                        }

                        <div class="flex-grow-1">
                            @if (!string.IsNullOrWhiteSpace(review.Summary))
                            {
                                <h4 class="h6 fw-bold mb-2">@review.Summary</h4>
                            }
                            <p class="review-excerpt mb-0">@review.Content</p>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 mt-3 border-top">
                            <button type="button" class="btn btn-sm btn-soft rounded-pill px-3 btn-like-review" data-id="@review.Id">
                                <i class="bi bi-heart me-1"></i>
                                <span class="like-count">@review.LikesCount</span>
                            </button>
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@review.Id" class="read-more-link">
                                기록 읽기 <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-5" aria-label="독서록 페이지">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-sort="@currentSort" asp-route-query="@Model.SearchQuery">이전</a>
                </li>
                @for (var p = Math.Max(1, Model.CurrentPage - 2); p <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p"
                           asp-route-sort="@currentSort" asp-route-query="@Model.SearchQuery">@p</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-sort="@currentSort" asp-route-query="@Model.SearchQuery">다음</a>
                </li>
            </ul>
        </nav>
    }
}
