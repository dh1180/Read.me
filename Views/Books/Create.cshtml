@model ReadMeApp.Models.ViewModels.CreateReviewRequest
@{
    ViewData["Title"] = "새 독서록 작성";
}

<div class="container py-4" style="max-width: 820px;">
    <!-- Top Back Link -->
    <div class="mb-4">
        <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1 small hover-opacity">
            <i class="bi bi-arrow-left"></i> 모두의 독서록으로 돌아가기
        </a>
    </div>

    <!-- Header -->
    <div class="mb-4 pb-3 border-bottom">
        <h2 class="fw-bold text-dark mb-1">새 독서록 작성하기</h2>
        <p class="text-muted small mb-0">읽은 책을 검색하고, 마음에 남은 생각과 문장을 자유롭게 기록해 보세요.</p>
    </div>

    <form asp-action="Create" method="post" id="createReviewForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2"></div>

        <!-- 1. Book Selection Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4" style="background: #ffffff; border: 1px solid #eef0f3 !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <span class="badge bg-primary rounded-circle p-1" style="width: 22px; height: 22px; font-size: 0.75rem;">1</span>
                    어떤 책을 읽으셨나요?
                </h5>
                <button type="button" class="btn btn-link text-secondary text-decoration-none small p-0" id="btnToggleManualInput">
                    <i class="bi bi-pencil me-1"></i>직접 도서 정보 입력
                </button>
            </div>

            <!-- Kakao Book Search Box -->
            <div id="searchBookSection" style="display: @(string.IsNullOrWhiteSpace(Model.Title) ? "block" : "none");">
                <div class="input-group mb-2">
                    <span class="input-group-text bg-white border-end-0 rounded-start-3 text-muted ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 ps-0" id="bookSearchInput" 
                           placeholder="도서명 또는 저자명을 입력하세요 (예: 불편한 편의점, 소크라테스)" autocomplete="off" />
                    <button class="btn btn-primary px-4 rounded-end-3 fw-semibold" type="button" id="btnSearchBook">검색</button>
                </div>
                <div class="form-text text-muted small ps-1">
                    <i class="bi bi-info-circle me-1"></i>카카오 도서 검색을 통해 표지와 도서 정보를 자동으로 채울 수 있습니다.
                </div>

                <!-- Search Results Dropdown/List Container -->
                <div id="searchResultsContainer" class="mt-3 border rounded-3 p-2 bg-light shadow-sm" style="display: none; max-height: 280px; overflow-y: auto;">
                    <div class="text-center py-3 text-muted small" id="searchLoadingSpinner" style="display: none;">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        도서 정보를 찾는 중입니다...
                    </div>
                    <div id="createSearchResultsList" class="list-group list-group-flush bg-transparent"></div>
                </div>
            </div>

            <!-- Selected Book Preview Box -->
            <div id="selectedBookCard" class="mt-3 p-3 rounded-3 bg-light border border-primary-subtle" style="display: @(string.IsNullOrWhiteSpace(Model.Title) ? "none" : "block");">
                <div class="d-flex gap-3 align-items-center">
                    <div class="flex-shrink-0" style="width: 64px; height: 90px;">
                        <img id="previewCover" src="@(string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "https://via.placeholder.com/64x90?text=No+Cover" : Model.CoverImageUrl)" 
                             alt="도서 표지" class="img-fluid rounded shadow-sm w-100 h-100" style="object-fit: cover;" />
                    </div>
                    <div class="flex-grow-1 overflow-hidden">
                        <span class="badge bg-primary-subtle text-primary mb-1 small">선택된 도서</span>
                        <h6 class="fw-bold mb-1 text-truncate text-dark" id="previewTitle">@(string.IsNullOrWhiteSpace(Model.Title) ? "도서명" : Model.Title)</h6>
                        <p class="text-muted small mb-0 text-truncate" id="previewAuthor">@(string.IsNullOrWhiteSpace(Model.Author) ? "저자" : Model.Author)</p>
                        <small class="text-secondary" id="previewPublisher">@(string.IsNullOrWhiteSpace(Model.Publisher) ? "" : Model.Publisher)</small>
                    </div>
                    <div>
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" id="btnChangeBook">
                            변경
                        </button>
                    </div>
                </div>
            </div>

            <!-- Manual Input Fields (Hidden by default unless toggled) -->
            <div id="manualBookFields" class="mt-3 pt-3 border-top" style="display: none;">
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">도서 제목 <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-sm rounded-3" id="manualTitle" placeholder="도서명 직접 입력" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-secondary">저자</label>
                        <input type="text" class="form-control form-control-sm rounded-3" id="manualAuthor" placeholder="저자명" />
                    </div>
                </div>
            </div>

            <!-- Hidden Inputs Bound to Model -->
            <input type="hidden" asp-for="Isbn" id="inputIsbn" />
            <input type="hidden" asp-for="Title" id="inputTitle" />
            <input type="hidden" asp-for="Author" id="inputAuthor" />
            <input type="hidden" asp-for="Publisher" id="inputPublisher" />
            <input type="hidden" asp-for="CoverImageUrl" id="inputCoverImageUrl" />
            <input type="hidden" asp-for="Description" id="inputDescription" />
            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
        </div>

        <!-- 2. Reviewer, Rating & Date -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4" style="background: #ffffff; border: 1px solid #eef0f3 !important;">
            <h5 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
                <span class="badge bg-primary rounded-circle p-1" style="width: 22px; height: 22px; font-size: 0.75rem;">2</span>
                작성 정보 &amp; 별점
            </h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="ReviewerName" class="form-label small fw-semibold text-secondary">
                        작성자 닉네임
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="badge rounded-pill ms-1 px-2 py-1" style="background-color: #f5f3ff; color: #7c3aed; font-size: 0.72rem;"><i class="bi bi-chat-fill me-1"></i>카카오</span>
                        }
                    </label>
                    <input asp-for="ReviewerName" class="form-control rounded-3" placeholder="닉네임" />
                </div>
                <div class="col-md-4">
                    <label asp-for="ReadDate" class="form-label small fw-semibold text-secondary">완독일</label>
                    <input asp-for="ReadDate" type="date" class="form-control rounded-3" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary">별점 주기</label>
                    <div class="d-flex align-items-center gap-2 pt-1">
                        <div id="starRatingSelector" class="star-rating-picker fs-4" style="cursor: pointer;">
                            <i class="bi bi-star-fill star-pick active" data-value="1"></i>
                            <i class="bi bi-star-fill star-pick active" data-value="2"></i>
                            <i class="bi bi-star-fill star-pick active" data-value="3"></i>
                            <i class="bi bi-star-fill star-pick active" data-value="4"></i>
                            <i class="bi bi-star-fill star-pick active" data-value="5"></i>
                        </div>
                        <span class="fw-bold text-dark small" id="lblRatingDescription">5.0점 (최고예요!)</span>
                        <input type="hidden" asp-for="Rating" id="inputReviewRating" value="5" />
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Memorable Quote & Title -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4" style="background: #ffffff; border: 1px solid #eef0f3 !important;">
            <h5 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
                <span class="badge bg-primary rounded-circle p-1" style="width: 22px; height: 22px; font-size: 0.75rem;">3</span>
                인상 깊은 한 문장 &amp; 제목
            </h5>

            <div class="mb-3">
                <label asp-for="Quote" class="form-label small fw-semibold text-secondary">
                    <i class="bi bi-quote text-primary me-1"></i>책 속 밑줄 친 한 문장 <span class="text-muted fw-normal">(선택)</span>
                </label>
                <textarea asp-for="Quote" class="form-control rounded-3" rows="2" 
                          placeholder="책을 읽으며 마음속에 오래 남기고 싶었던 구절을 적어보세요..."></textarea>
            </div>

            <div>
                <label asp-for="Summary" class="form-label small fw-semibold text-secondary">
                    독서록 제목 / 한 줄 요약 <span class="text-muted fw-normal">(선택)</span>
                </label>
                <input asp-for="Summary" class="form-control rounded-3" 
                       placeholder="예: 삶의 무게를 유쾌한 시선으로 풀어낸 인생 책" maxlength="150" />
            </div>
        </div>

        <!-- 4. Review Content & Template Studio -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 p-4" style="background: #ffffff; border: 1px solid #eef0f3 !important;">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                    <span class="badge bg-primary rounded-circle p-1" style="width: 22px; height: 22px; font-size: 0.75rem;">4</span>
                    독서 감상평 본문 <span class="text-danger">*</span>
                </h5>

                <!-- Quick Template Selectors -->
                <div class="d-flex align-items-center gap-1 flex-wrap">
                    <span class="text-muted small me-1"><i class="bi bi-magic me-1"></i>템플릿:</span>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 template-btn" data-type="free" style="font-size: 0.75rem;">
                        💡 자유 감상형
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 template-btn" data-type="summary" style="font-size: 0.75rem;">
                        📌 핵심 &amp; 실천형
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 template-btn" data-type="short" style="font-size: 0.75rem;">
                        💬 3줄 소감형
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1 template-btn" data-type="clear" style="font-size: 0.75rem;">
                        🔄 비우기
                    </button>
                </div>
            </div>

            <!-- Tab Switcher (Write vs Live Markdown Preview) -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="btn-group p-1 bg-light rounded-pill border" role="group" id="editorModeGroup">
                    <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold" id="btnModeWrite" style="background-color: #7c3aed; color: #ffffff; font-size: 0.8rem;">
                        <i class="bi bi-pencil-fill me-1"></i>작성하기
                    </button>
                    <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold text-secondary" id="btnModePreview" style="background-color: transparent; font-size: 0.8rem;">
                        <i class="bi bi-eye-fill me-1"></i>미리보기
                    </button>
                </div>

                <div class="text-muted small d-none d-sm-flex align-items-center gap-2" style="font-size: 0.78rem;">
                    <span><i class="bi bi-markdown text-primary me-1"></i>마크다운 지원:</span>
                    <span class="badge bg-light text-secondary border">## 제목</span>
                    <span class="badge bg-light text-secondary border">**굵게**</span>
                    <span class="badge bg-light text-secondary border">> 인용</span>
                    <span class="badge bg-light text-secondary border">- 목록</span>
                </div>
            </div>

            <!-- Write Mode Pane -->
            <div id="paneWrite">
                <textarea asp-for="Content" id="txtReviewContent" class="form-control rounded-3" rows="12" 
                          placeholder="책을 읽고 어떤 생각이 들었나요? 마크다운 문법(## 제목, **굵게**, > 인용구 등)을 사용해 자유롭게 작성하실 수 있습니다. 상단 [미리보기] 탭을 누르면 실시간으로 변환된 서식을 확인할 수 있습니다." required></textarea>
                <span asp-validation-for="Content" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Live Markdown Preview Pane -->
            <div id="panePreview" class="p-4 bg-light rounded-3 border markdown-content" style="display: none; min-height: 280px; max-height: 520px; overflow-y: auto;">
                <div class="text-muted text-center py-5" id="previewEmptyState">
                    <i class="bi bi-markdown fs-1 text-secondary opacity-50"></i>
                    <p class="mt-2 small text-secondary mb-0">작성된 내용이 없습니다. [작성하기] 탭에서 내용을 입력해 보세요.</p>
                </div>
                <div id="previewRenderedContent" style="display: none;"></div>
            </div>
        </div>

        <!-- Submit Bar -->
        <div class="d-flex justify-content-between align-items-center pt-2 mb-5">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                취소하고 돌아가기
            </a>
            <button type="submit" class="btn btn-primary-gradient rounded-pill px-5 py-2 fw-semibold shadow">
                <i class="bi bi-check2-circle me-1"></i> 독서록 등록하기
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        // 1. Markdown Template Strings
        const templates = {
            free: `## 📖 책을 읽게 된 계기
- 

## 💭 가장 인상 깊었던 내용과 생각
- 

> "마음에 남은 문장이나 구절을 여기에 적어보세요"

## ✨ 이 책을 추천하고 싶은 사람
- `,

            summary: `## 💡 책의 핵심 메시지
> 

## 📌 기억하고 싶은 핵심 내용 3가지
1. 
2. 
3. 

## 🏃 내 삶에 적용해 볼 실천점
- `,

            short: `1. **읽기 전 기대:** 
2. **읽고 난 후 소감:** 
3. **나만의 한 줄 총평:** `
        };

        // Editor Tab Switching: Write vs Preview
        const btnWrite = document.getElementById('btnModeWrite');
        const btnPreview = document.getElementById('btnModePreview');
        const paneWrite = document.getElementById('paneWrite');
        const panePreview = document.getElementById('panePreview');
        const txtReview = document.getElementById('txtReviewContent');
        const previewEmpty = document.getElementById('previewEmptyState');
        const previewRendered = document.getElementById('previewRenderedContent');

        function updateMarkdownPreview() {
            const raw = txtReview.value.trim();
            if (!raw) {
                previewEmpty.style.display = 'block';
                previewRendered.style.display = 'none';
                previewRendered.innerHTML = '';
            } else {
                previewEmpty.style.display = 'none';
                previewRendered.style.display = 'block';
                if (typeof marked !== 'undefined') {
                    previewRendered.innerHTML = marked.parse(raw);
                } else {
                    previewRendered.innerHTML = raw.replace(/\n/g, '<br/>');
                }
            }
        }

        function switchToWriteMode() {
            btnWrite.style.backgroundColor = '#7c3aed';
            btnWrite.style.color = '#ffffff';
            btnPreview.style.backgroundColor = 'transparent';
            btnPreview.style.color = '#6c757d';
            paneWrite.style.display = 'block';
            panePreview.style.display = 'none';
            txtReview.focus();
        }

        function switchToPreviewMode() {
            btnPreview.style.backgroundColor = '#7c3aed';
            btnPreview.style.color = '#ffffff';
            btnWrite.style.backgroundColor = 'transparent';
            btnWrite.style.color = '#6c757d';
            updateMarkdownPreview();
            paneWrite.style.display = 'none';
            panePreview.style.display = 'block';
        }

        btnWrite.addEventListener('click', switchToWriteMode);
        btnPreview.addEventListener('click', switchToPreviewMode);

        txtReview.addEventListener('input', () => {
            if (panePreview.style.display !== 'none') {
                updateMarkdownPreview();
            }
        });

        // Template button click handler
        document.querySelectorAll('.template-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const type = this.getAttribute('data-type');
                
                if (type === 'clear') {
                    if (txtReview.value.trim() !== '' && !confirm('작성 중인 내용을 모두 지우시겠습니까?')) {
                        return;
                    }
                    txtReview.value = '';
                    updateMarkdownPreview();
                    switchToWriteMode();
                    return;
                }

                if (templates[type]) {
                    if (txtReview.value.trim() !== '') {
                        if (confirm('현재 작성된 내용 아래에 템플릿을 추가할까요? (취소 시 기존 내용 대체)')) {
                            txtReview.value += '\n\n' + templates[type];
                        } else {
                            txtReview.value = templates[type];
                        }
                    } else {
                        txtReview.value = templates[type];
                    }
                    updateMarkdownPreview();
                    switchToWriteMode();
                }
            });
        });

        // 2. Star Rating Picker
        const starLabels = {
            1: "1.0점 (아쉬워요)",
            2: "2.0점 (조금 아쉬워요)",
            3: "3.0점 (보통이에요)",
            4: "4.0점 (좋았어요)",
            5: "5.0점 (최고예요!)"
        };
        const starPicks = document.querySelectorAll('#starRatingSelector .star-pick');
        const inputRating = document.getElementById('inputReviewRating');
        const lblRating = document.getElementById('lblRatingDescription');

        starPicks.forEach(star => {
            star.addEventListener('click', function() {
                const val = parseInt(this.getAttribute('data-value'));
                inputRating.value = val;
                lblRating.textContent = starLabels[val] || `${val}.0점`;

                starPicks.forEach(s => {
                    const sVal = parseInt(s.getAttribute('data-value'));
                    if (sVal <= val) {
                        s.classList.remove('bi-star');
                        s.classList.add('bi-star-fill', 'active');
                    } else {
                        s.classList.remove('bi-star-fill', 'active');
                        s.classList.add('bi-star');
                    }
                });
            });
        });

        // Helper: HTML escape
        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // 3. Kakao Book Search
        const searchInput = document.getElementById('bookSearchInput');
        const btnSearch = document.getElementById('btnSearchBook');
        const resultsContainer = document.getElementById('searchResultsContainer');
        const resultsList = document.getElementById('createSearchResultsList');
        const loadingSpinner = document.getElementById('searchLoadingSpinner');

        async function executeSearch() {
            const q = searchInput.value.trim();
            if (!q) {
                alert('검색할 도서명을 입력해 주세요.');
                searchInput.focus();
                return;
            }

            resultsContainer.style.display = 'block';
            resultsList.innerHTML = '';
            loadingSpinner.style.display = 'block';

            try {
                // Call /Search/Query endpoint with fallback to /Search/SearchBooks
                let resp = await fetch(`/Search/Query?q=${encodeURIComponent(q)}`);
                if (!resp.ok) {
                    resp = await fetch(`/Search/SearchBooks?query=${encodeURIComponent(q)}`);
                }
                if (!resp.ok) {
                    throw new Error(`HTTP error ${resp.status}`);
                }
                const json = await resp.json();
                loadingSpinner.style.display = 'none';

                if (json.success && json.data && json.data.length > 0) {
                    json.data.forEach(book => {
                        const item = document.createElement('a');
                        item.href = 'javascript:void(0);';
                        item.className = 'list-group-item list-group-item-action d-flex align-items-center gap-3 p-2 border-0 rounded-3 mb-1';
                        
                        const coverSrc = book.coverImageUrl || 'https://via.placeholder.com/48x68?text=Book';
                        item.innerHTML = `
                            <img src="${coverSrc}" class="rounded shadow-sm flex-shrink-0" style="width: 42px; height: 60px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/42x60?text=NoCover'">
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold text-dark text-truncate small">${escapeHtml(book.title)}</div>
                                <div class="text-muted small text-truncate" style="font-size: 0.75rem;">${escapeHtml(book.author || '저자 미상')} | ${escapeHtml(book.publisher || '출판사')}</div>
                            </div>
                            <span class="btn btn-sm btn-primary rounded-pill px-3 py-1 small fw-semibold">선택</span>
                        `;

                        item.addEventListener('click', () => {
                            selectBook(book);
                        });

                        resultsList.appendChild(item);
                    });
                } else {
                    resultsList.innerHTML = '<div class="text-center py-3 text-muted small">검색 결과가 없습니다. 도서명을 확인해 주세요.</div>';
                }
            } catch (err) {
                console.error("도서 검색 오류:", err);
                loadingSpinner.style.display = 'none';
                resultsList.innerHTML = '<div class="text-center py-3 text-danger small">도서 검색 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.</div>';
            }
        }

        btnSearch.addEventListener('click', executeSearch);
        searchInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                executeSearch();
            }
        });

        function selectBook(book) {
            document.getElementById('inputIsbn').value = book.isbn || '';
            document.getElementById('inputTitle').value = book.title || '';
            document.getElementById('inputAuthor').value = book.author || '';
            document.getElementById('inputPublisher').value = book.publisher || '';
            document.getElementById('inputCoverImageUrl').value = book.coverImageUrl || '';
            document.getElementById('inputDescription').value = book.description || '';

            // Update UI preview
            document.getElementById('previewTitle').textContent = book.title;
            document.getElementById('previewAuthor').textContent = book.author || '저자 미상';
            document.getElementById('previewPublisher').textContent = book.publisher || '';
            document.getElementById('previewCover').src = book.coverImageUrl || 'https://via.placeholder.com/64x90?text=No+Cover';

            document.getElementById('searchBookSection').style.display = 'none';
            document.getElementById('selectedBookCard').style.display = 'block';
            resultsContainer.style.display = 'none';
        }

        document.getElementById('btnChangeBook').addEventListener('click', () => {
            document.getElementById('selectedBookCard').style.display = 'none';
            document.getElementById('searchBookSection').style.display = 'block';
            searchInput.focus();
        });

        // Manual Book input toggling
        document.getElementById('btnToggleManualInput').addEventListener('click', () => {
            const manualSec = document.getElementById('manualBookFields');
            if (manualSec.style.display === 'none') {
                manualSec.style.display = 'block';
                document.getElementById('searchBookSection').style.display = 'none';
            } else {
                manualSec.style.display = 'none';
                document.getElementById('searchBookSection').style.display = 'block';
            }
        });

        document.getElementById('manualTitle').addEventListener('input', function() {
            document.getElementById('inputTitle').value = this.value;
            document.getElementById('previewTitle').textContent = this.value;
        });

        document.getElementById('manualAuthor').addEventListener('input', function() {
            document.getElementById('inputAuthor').value = this.value;
            document.getElementById('previewAuthor').textContent = this.value;
        });
    </script>
}
