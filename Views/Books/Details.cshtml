@model ReadMeApp.Models.UserBook
@using ReadMeApp.Models
@{
    var bookTitle = Model.Book?.Title ?? "도서 독서록";
    var bookAuthor = Model.Book?.Author ?? "저자 미상";
    var reviewer = string.IsNullOrWhiteSpace(Model.ReviewerName) ? "독서가" : Model.ReviewerName;
    var isOwner = User.Identity?.IsAuthenticated == true && string.Equals(Model.ReviewerName, User.Identity.Name, StringComparison.Ordinal);
    ViewData["Title"] = $"{bookTitle} ({bookAuthor}) - {reviewer}님의 독서록";
    
    var desc = !string.IsNullOrWhiteSpace(Model.Summary)
        ? $"{bookTitle}({bookAuthor}) 독서록: {Model.Summary}"
        : (!string.IsNullOrWhiteSpace(Model.Quote)
            ? $"\"{Model.Quote}\" - {bookTitle} 독서록 ({reviewer})"
            : $"{reviewer}님이 기록한 '{bookTitle}' 도서 감상평과 서평입니다.");
    
    ViewData["MetaDescription"] = desc;
    ViewData["OgTitle"] = $"{bookTitle} - {reviewer}님의 독서록 | Read.me";
    ViewData["OgDescription"] = desc;
    ViewData["OgType"] = "article";
    if (!string.IsNullOrWhiteSpace(Model.Book?.CoverImageUrl))
    {
        ViewData["OgImage"] = Model.Book.CoverImageUrl;
    }
}

<!-- Schema.org Book & Review Rich Snippet -->
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "Review",
  "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"{bookTitle} 독서록")),
  "reviewBody": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Content ?? "")),
  "reviewRating": {
    "@@type": "Rating",
    "ratingValue": @Model.Rating,
    "bestRating": 5,
    "worstRating": 1
  },
  "author": {
    "@@type": "Person",
    "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(reviewer))
  },
  "itemReviewed": {
    "@@type": "Book",
    "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bookTitle)),
    "author": {
      "@@type": "Person",
      "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bookAuthor))
    },
    "isbn": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Book?.Isbn ?? "")),
    "image": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Book?.CoverImageUrl ?? ""))
  }
}
</script>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> 모두의 독서록으로
    </a>
    <a asp-controller="Books" asp-action="Create" class="btn btn-primary-gradient btn-sm px-3 rounded-pill">
        <i class="bi bi-pencil-square me-1"></i> 새 독서록 작성
    </a>
</div>

<!-- Book Header Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
    <div class="card-body p-4 p-md-5">
        <div class="row g-4 align-items-start">
            <div class="col-md-3 text-center">
                @if (!string.IsNullOrWhiteSpace(Model.Book?.CoverImageUrl))
                {
                    <img src="@Model.Book.CoverImageUrl" alt="@Model.Book.Title" class="img-fluid rounded shadow-sm shelf-book-cover" style="max-height: 240px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center mx-auto" style="height: 200px; width: 140px;">
                        <i class="bi bi-book fs-1"></i>
                    </div>
                }
            </div>
            <div class="col-md-9">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                        <i class="bi bi-book me-1"></i> 독서록
                    </span>
                    <span class="text-muted small">ISBN: @Model.Book?.Isbn</span>
                </div>
                <h2 class="fw-bold mb-2 text-dark">@Model.Book?.Title</h2>
                <h5 class="text-muted mb-3 fs-6">@(Model.Book?.Author ?? "저자 미상") | @(Model.Book?.Publisher ?? "")</h5>
                
                @if (!string.IsNullOrWhiteSpace(Model.Book?.Description))
                {
                    <p class="text-secondary small mb-3" style="line-height: 1.6;">@Model.Book.Description</p>
                }

                <div class="d-flex flex-wrap gap-4 text-muted small border-top pt-3">
                    <div><i class="bi bi-person me-1"></i> 작성자: <strong>@Model.ReviewerName</strong></div>
                    <div><i class="bi bi-calendar3 me-1"></i> 완독일: <strong>@Model.ReadDate.ToString("yyyy년 MM월 dd일")</strong></div>
                    <div><i class="bi bi-heart-fill text-danger me-1"></i> 좋아요: <strong>@Model.LikesCount</strong>개</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reading Review Main Card -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning-subtle text-warning p-2 rounded-3">
                <i class="bi bi-star-fill fs-5"></i>
            </span>
            <div>
                <h5 class="fw-bold mb-0 text-dark">독서 감상평</h5>
                <span class="text-muted small">@Model.ReviewerName 님이 남긴 기록</span>
            </div>
        </div>

        <!-- Star Rating Display -->
        <div class="d-flex align-items-center gap-1">
            @for (int i = 1; i <= 5; i++)
            {
                if (i <= Model.Rating)
                {
                    <i class="bi bi-star-fill text-warning fs-5"></i>
                }
                else
                {
                    <i class="bi bi-star text-black-50 opacity-25 fs-5"></i>
                }
            }
            <span class="fw-bold fs-5 text-dark ms-2">@Model.Rating.0 / 5.0</span>
        </div>
    </div>

    <div class="card-body p-4 pt-2">
        <!-- Memorable Quote (if exists) -->
        @if (!string.IsNullOrWhiteSpace(Model.Quote))
        {
            <div class="quote-callout my-3 p-4 rounded-3 position-relative" style="background: #f3f6f1; border-left: 5px solid #5c7d66;">
                <i class="bi bi-quote text-primary opacity-50 fs-2 position-absolute" style="top: -2px; left: 8px;"></i>
                <h6 class="fw-bold text-dark mb-1 ps-4" style="font-size: 0.85rem; color: #35523f !important;">
                    <i class="bi bi-lightbulb-fill me-1"></i> 인상 깊은 한 문장
                </h6>
                <p class="mb-0 text-dark fst-italic ps-4 fs-6" style="line-height: 1.7;">
                    "@Model.Quote"
                </p>
            </div>
        }

        <!-- Summary / One-line Review -->
        @if (!string.IsNullOrWhiteSpace(Model.Summary))
        {
            <div class="alert alert-light border my-3 py-2 px-3 rounded-3">
                <strong class="text-primary me-2"><i class="bi bi-chat-heart me-1"></i> 한 줄 평:</strong>
                <span class="fw-semibold text-dark">@Model.Summary</span>
            </div>
        }

        <!-- Full Review Body (Markdown Rendered) -->
        <div class="review-body p-4 my-3 bg-light rounded-4">
            <h6 class="fw-bold text-secondary mb-3 d-flex align-items-center gap-1" style="font-size: 0.85rem;">
                <i class="bi bi-file-earmark-text text-primary me-1"></i> 상세 감상평
                <span class="badge bg-primary-subtle text-primary small ms-auto fw-normal" style="font-size: 0.72rem;">Markdown</span>
            </h6>
            <div class="markdown-content text-dark fs-6" style="line-height: 1.8;">
                @Html.Raw(Model.ContentHtml)
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4">
            <button type="button" class="btn btn-outline-danger rounded-pill px-4 py-2 btn-like-review" data-id="@Model.Id">
                <i class="bi bi-heart-fill me-1"></i>
                이 독서록에 공감해요 <strong class="like-count" id="like-count-@Model.Id">@Model.LikesCount</strong>
            </button>
            <span class="text-muted small">작성일: @Model.CreatedAt.ToString("yyyy.MM.dd HH:mm")</span>
        </div>
    </div>
</div>

<!-- Reading Notes & Quotes Section -->
<div class="row g-4">
    <!-- Left: New Note Form with Live Markdown Preview -->
    @if (isOwner)
    {
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm sticky-top" style="top: 80px; border-radius: 16px;">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-pencil-square text-success me-1"></i> 추가 메모 &amp; 필사 남기기</h5>
            </div>
            <div class="card-body p-4 pt-0">
                <form id="formAddNote">
                    <input type="hidden" id="noteUserBookId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label for="inputNotePage" class="form-label small fw-bold">페이지 번호</label>
                        <input type="number" class="form-control form-control-sm rounded-3" id="inputNotePage" min="1" value="1" placeholder="예: 42" required />
                    </div>

                    <div class="mb-3">
                        <label for="inputNoteQuote" class="form-label small fw-bold">책 속 인용구 (선택)</label>
                        <textarea class="form-control form-control-sm rounded-3" id="inputNoteQuote" rows="2" placeholder="기억하고 싶은 구절을 적어보세요..."></textarea>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label for="inputNoteThought" class="form-label small fw-bold mb-0">생각 &amp; 메모</label>
                            <span class="badge bg-light text-secondary border small"># bold, *italic*, > quote</span>
                        </div>
                        <textarea class="form-control form-control-sm rounded-3 mt-1" id="inputNoteThought" rows="3" placeholder="이 문장에 대한 내 생각이나 메모를 남겨보세요." required></textarea>
                    </div>

                    <!-- Live Markdown Preview -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">실시간 미리보기</label>
                        <div class="p-3 bg-light rounded border small" id="noteLivePreview" style="min-height: 50px;">
                            <em class="text-muted">입력한 내용이 실시간으로 여기에 렌더링됩니다.</em>
                        </div>
                    </div>

                    <button type="button" class="btn btn-success w-100 rounded-pill" id="btnSaveNoteAjax">
                        <i class="bi bi-save me-1"></i> 메모 저장
                    </button>
                </form>
            </div>
        </div>
    </div>

    }

    <!-- Right: Notes Timeline -->
    <div class="@(isOwner ? "col-lg-7" : "col-12")">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-chat-left-quote-fill text-info me-1"></i> 추가 기록 목록 (<span id="notesCount">@Model.Notes.Count</span>)
            </h5>
        </div>

        <div id="notesContainer" class="d-flex flex-column gap-3">
            @if (Model.Notes.Count == 0)
            {
                <div class="card border-0 shadow-sm text-center py-5" id="emptyNotesPlaceholder" style="border-radius: 16px;">
                    <div class="card-body">
                        <i class="bi bi-journal-text text-muted fs-1"></i>
                        <p class="text-muted mt-2">아직 기록된 추가 필사/메모가 없습니다.<br />왼쪽 폼에서 필요한 메모를 남겨보세요!</p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var note in Model.Notes)
                {
                    <div class="card border-0 shadow-sm p-3 border-start border-4 border-info" id="note-item-@note.Id" style="border-radius: 12px;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary rounded-pill px-2">p.@note.PageNumber</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">@note.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                @if (isOwner)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1 btn-delete-note" data-id="@note.Id" title="메모 삭제">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(note.Quote))
                        {
                            <blockquote class="blockquote fs-6 text-muted ps-3 border-start border-3 my-2 fst-italic">
                                "@note.Quote"
                            </blockquote>
                        }

                        <div class="markdown-body small text-dark mt-2">
                            @Html.Raw(note.ThoughtHtml)
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

