@model ReadMeApp.Models.UserBook
@using ReadMeApp.Models
@{
    ViewData["Title"] = Model.Book?.Title ?? "도서 상세";
    var totalPages = Model.Book?.TotalPages ?? 300;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left"></i> 서재 목록으로 돌아가기
    </a>
</div>

<!-- Book Header Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="row g-4 align-items-center">
            <div class="col-md-3 col-lg-2 text-center">
                @if (!string.IsNullOrWhiteSpace(Model.Book?.CoverImageUrl))
                {
                    <img src="@Model.Book.CoverImageUrl" alt="@Model.Book.Title" class="img-fluid rounded shadow" style="max-height: 220px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center" style="height: 180px;">
                        <i class="bi bi-book fs-1"></i>
                    </div>
                }
            </div>
            <div class="col-md-9 col-lg-10">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge @(Model.Status == ReadingStatus.Completed ? "bg-success" : Model.Status == ReadingStatus.Reading ? "bg-primary" : "bg-warning text-dark") fs-6" id="badge-detail-status">
                        @Model.Status
                    </span>
                    <span class="text-muted small">ISBN: @Model.Book?.Isbn</span>
                </div>
                <h2 class="fw-bold mb-2">@Model.Book?.Title</h2>
                <h5 class="text-muted mb-3">@Model.Book?.Author | @Model.Book?.Publisher</h5>
                
                @if (!string.IsNullOrWhiteSpace(Model.Book?.Description))
                {
                    <p class="text-secondary small mb-3">@Model.Book.Description</p>
                }

                <div class="d-flex flex-wrap gap-4 text-muted small border-top pt-3">
                    <div><i class="bi bi-file-text"></i> 총 <strong>@totalPages</strong> 페이지</div>
                    <div><i class="bi bi-calendar-check"></i> 시작일: <strong>@(Model.StartDate?.ToString("yyyy-MM-dd") ?? "미시작")</strong></div>
                    <div><i class="bi bi-check2-circle"></i> 완독일: <strong>@(Model.CompletedDate?.ToString("yyyy-MM-dd") ?? "진행 중")</strong></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Interactive Reading Progress (jQuery Ajax) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0"><i class="bi bi-sliders text-primary"></i> 독서 진행률 관리 (실시간 Ajax)</h5>
    </div>
    <div class="card-body p-4 pt-0">
        <div class="row align-items-center g-3">
            <div class="col-md-7">
                <label for="rangeProgress" class="form-label d-flex justify-content-between">
                    <span>슬라이더로 페이지 조절</span>
                    <span class="fw-bold text-primary"><span id="lblProgressPercentage">@Model.ProgressPercentage</span>% 완료</span>
                </label>
                <input type="range" class="form-range" id="rangeProgress" min="0" max="@totalPages" value="@Model.CurrentPage" />
            </div>
            <div class="col-md-3">
                <label class="form-label">읽은 페이지 수</label>
                <div class="input-group">
                    <input type="number" class="form-control" id="inputCurrentPage" min="0" max="@totalPages" value="@Model.CurrentPage" />
                    <span class="input-group-text">/ @totalPages p</span>
                </div>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-primary w-100" id="btnUpdateProgressAjax" data-id="@Model.Id">
                    <i class="bi bi-check-lg"></i> 저장
                </button>
            </div>
        </div>
        <div class="progress mt-3" style="height: 10px;">
            <div class="progress-bar bg-primary" id="detailProgressBar" role="progressbar" style="width: @Model.ProgressPercentage%;"></div>
        </div>
    </div>
</div>

<!-- Reading Notes & Quotes Section -->
<div class="row g-4">
    <!-- Left: New Note Form with Live Markdown Preview -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm sticky-top" style="top: 80px;">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-pencil-square text-success"></i> 필사 &amp; 메모 작성</h5>
            </div>
            <div class="card-body p-4 pt-0">
                <form id="formAddNote">
                    <input type="hidden" id="noteUserBookId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label for="inputNotePage" class="form-label small fw-bold">페이지 번호</label>
                        <input type="number" class="form-control form-control-sm" id="inputNotePage" min="1" max="@totalPages" value="@(Model.CurrentPage > 0 ? Model.CurrentPage : 1)" placeholder="예: 42" required />
                    </div>

                    <div class="mb-3">
                        <label for="inputNoteQuote" class="form-label small fw-bold">인상 깊은 문장 (인용구)</label>
                        <textarea class="form-control form-control-sm" id="inputNoteQuote" rows="3" placeholder="책 속에서 기억하고 싶은 구절을 적어보세요..."></textarea>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label for="inputNoteThought" class="form-label small fw-bold mb-0">생각 &amp; 감상 (Markdown 지원)</label>
                            <span class="badge bg-light text-secondary border small"># bold, *italic*, > quote</span>
                        </div>
                        <textarea class="form-control form-control-sm mt-1" id="inputNoteThought" rows="4" placeholder="이 문장에 대한 내 생각, 적용하고 싶은 점을 적어보세요." required></textarea>
                    </div>

                    <!-- Live Markdown Preview -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">실시간 마크다운 미리보기</label>
                        <div class="p-3 bg-light rounded border small" id="noteLivePreview" style="min-height: 60px;">
                            <em class="text-muted">입력한 내용이 실시간으로 여기에 렌더링됩니다.</em>
                        </div>
                    </div>

                    <button type="button" class="btn btn-success w-100" id="btnSaveNoteAjax">
                        <i class="bi bi-save"></i> 메모 저장 (Ajax)
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Right: Notes Timeline -->
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-chat-left-quote-fill text-info"></i> 기록된 노트 목록 (<span id="notesCount">@Model.Notes.Count</span>)
            </h5>
        </div>

        <div id="notesContainer" class="d-flex flex-column gap-3">
            @if (Model.Notes.Count == 0)
            {
                <div class="card border-0 shadow-sm text-center py-5" id="emptyNotesPlaceholder">
                    <div class="card-body">
                        <i class="bi bi-journal-text text-muted fs-1"></i>
                        <p class="text-muted mt-2">아직 기록된 필사/메모가 없습니다.<br />왼쪽 폼에서 첫 번째 메모를 작성해 보세요!</p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var note in Model.Notes)
                {
                    <div class="card border-0 shadow-sm p-3 border-start border-4 border-info" id="note-item-@note.Id">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary">p.@note.PageNumber</span>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">@note.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-1 btn-delete-note" data-id="@note.Id" title="메모 삭제">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(note.Quote))
                        {
                            <blockquote class="blockquote fs-6 text-muted ps-3 border-start border-3 my-2 fst-italic">
                                "@note.Quote"
                            </blockquote>
                        }

                        <div class="markdown-body small text-dark mt-2">
                            @Html.Raw(note.ThoughtHtml)
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
