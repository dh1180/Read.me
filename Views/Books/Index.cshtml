@model List<ReadMeApp.Models.UserBook>
@using ReadMeApp.Models
@{
    ViewData["Title"] = "내 기록";
    var currentSort = (string?)ViewBag.CurrentSort ?? "latest";
    var searchQuery = (string?)ViewBag.SearchQuery;
    var currentStatus = (string?)ViewBag.CurrentStatus ?? "all";
    var currentPage = (int?)ViewBag.CurrentPage ?? 1;
    var totalPages = (int?)ViewBag.TotalPages ?? 1;
    var filteredCount = (int?)ViewBag.FilteredCount ?? Model.Count;
}

<section class="page-heading d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <span class="eyebrow">MY READING</span>
        <h1 class="h3 fw-bold mb-1">내 독서 기록</h1>
        <p class="text-muted mb-0">읽고 싶은 책부터 완독한 책까지 한곳에서 관리하세요.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#searchModal">
            <i class="bi bi-search me-1"></i> 책 찾기
        </button>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
            <i class="bi bi-pencil-square me-1"></i> 독서록 쓰기
        </a>
    </div>
</section>

<div class="library-toolbar mb-4">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-action="Index" asp-route-status="all" asp-route-sort="@currentSort" asp-route-query="@searchQuery"
           class="btn btn-sm rounded-pill px-3 @(currentStatus == "all" ? "btn-primary" : "btn-soft")">전체</a>
        <a asp-action="Index" asp-route-status="wishlist" asp-route-sort="@currentSort" asp-route-query="@searchQuery"
           class="btn btn-sm rounded-pill px-3 @(currentStatus == "wishlist" ? "btn-primary" : "btn-soft")">읽고 싶은 책</a>
        <a asp-action="Index" asp-route-status="reading" asp-route-sort="@currentSort" asp-route-query="@searchQuery"
           class="btn btn-sm rounded-pill px-3 @(currentStatus == "reading" ? "btn-primary" : "btn-soft")">읽는 중</a>
        <a asp-action="Index" asp-route-status="completed" asp-route-sort="@currentSort" asp-route-query="@searchQuery"
           class="btn btn-sm rounded-pill px-3 @(currentStatus == "completed" ? "btn-primary" : "btn-soft")">완독</a>
    </div>

    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div class="d-flex gap-2 align-items-center">
            <span class="text-muted small">총 <strong>@filteredCount</strong>개의 기록</span>
            <span class="text-muted">·</span>
            <a asp-action="Index" asp-route-status="@currentStatus" asp-route-sort="latest" asp-route-query="@searchQuery"
               class="small text-decoration-none @(currentSort == "latest" ? "fw-bold text-primary" : "text-muted")">최근순</a>
            <a asp-action="Index" asp-route-status="@currentStatus" asp-route-sort="rating" asp-route-query="@searchQuery"
               class="small text-decoration-none @(currentSort == "rating" ? "fw-bold text-primary" : "text-muted")">별점순</a>
        </div>
        <form asp-action="Index" method="get" class="library-search">
            <input type="hidden" name="sort" value="@currentSort" />
            <input type="hidden" name="status" value="@currentStatus" />
            <div class="input-group input-group-sm">
                <input type="text" name="query" class="form-control" placeholder="내 기록 검색" value="@searchQuery" />
                <button class="btn btn-primary px-3" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-book"></i></div>
        <h2 class="h5 fw-bold">아직 이곳에 책이 없어요.</h2>
        <p class="text-muted mb-4">읽고 싶은 책을 담거나 첫 독서록을 작성해 보세요.</p>
        <button type="button" class="btn btn-outline-primary rounded-pill px-4 me-2" data-bs-toggle="modal" data-bs-target="#searchModal">책 찾기</button>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">독서록 쓰기</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var item in Model)
        {
            var statusText = item.Status switch
            {
                ReadingStatus.Wishlist => "읽고 싶은 책",
                ReadingStatus.Reading => "읽는 중",
                _ => "완독"
            };
            var statusClass = item.Status switch
            {
                ReadingStatus.Wishlist => "status-wishlist",
                ReadingStatus.Reading => "status-reading",
                _ => "status-completed"
            };

            <div class="col">
                <article class="card library-card h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex gap-3">
                            <div class="library-cover">
                                @if (!string.IsNullOrWhiteSpace(item.Book?.CoverImageUrl))
                                {
                                    <img src="@item.Book.CoverImageUrl" alt="@item.Book.Title" />
                                }
                                else
                                {
                                    <span><i class="bi bi-book"></i></span>
                                }
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <span class="reading-status @statusClass">@statusText</span>
                                <h2 class="h6 fw-bold mt-2 mb-1 text-truncate">@item.Book?.Title</h2>
                                <p class="text-muted small mb-2 text-truncate">@item.Book?.Author</p>
                                @if (item.Status == ReadingStatus.Completed)
                                {
                                    <div class="small rating-inline"><i class="bi bi-star-fill"></i> @item.Rating.0</div>
                                }
                            </div>
                        </div>

                        <div class="mt-3 flex-grow-1">
                            @if (!string.IsNullOrWhiteSpace(item.Summary))
                            {
                                <p class="fw-semibold small mb-2">@item.Summary</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Content))
                            {
                                <p class="review-excerpt mb-0">@item.Content</p>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">아직 감상평을 작성하지 않았습니다.</p>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 mt-3 border-top">
                            <span class="text-muted small">@item.UpdatedAt.ToString("yyyy.MM.dd")</span>
                            <div class="d-flex gap-1">
                                @if (item.Status == ReadingStatus.Completed && !string.IsNullOrWhiteSpace(item.Content))
                                {
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-soft rounded-pill px-3">기록 보기</a>
                                }
                                else
                                {
                                    <a asp-action="Create" asp-route-isbn="@item.Book?.Isbn" asp-route-title="@item.Book?.Title"
                                       asp-route-author="@item.Book?.Author" asp-route-cover="@item.Book?.CoverImageUrl"
                                       class="btn btn-sm btn-primary rounded-pill px-3">독서록 쓰기</a>
                                }
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('이 독서 기록을 삭제하시겠습니까?');">
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-1" title="삭제"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-status="@currentStatus"
                       asp-route-sort="@currentSort" asp-route-query="@searchQuery">이전</a>
                </li>
                @for (var p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-status="@currentStatus"
                           asp-route-sort="@currentSort" asp-route-query="@searchQuery">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-status="@currentStatus"
                       asp-route-sort="@currentSort" asp-route-query="@searchQuery">다음</a>
                </li>
            </ul>
        </nav>
    }
}
