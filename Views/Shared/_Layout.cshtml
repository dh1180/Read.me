<!DOCTYPE html>
<html lang="ko">
<head>
    <!-- Google tag (gtag.js) - Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-27YGZ0KWJF"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-27YGZ0KWJF');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    @{
        var pageTitle = ViewData["Title"]?.ToString() ?? "모두의 독서록";
        var metaDesc = ViewData["MetaDescription"]?.ToString() ?? "읽은 책의 솔직한 생각과 인상 깊은 한 문장을 기록하고 나누는 모던 독서 기록 커뮤니티 Read.me입니다.";
        var ogTitle = ViewData["OgTitle"]?.ToString() ?? $"{pageTitle} - Read.me";
        var ogDesc = ViewData["OgDescription"]?.ToString() ?? metaDesc;
        var ogType = ViewData["OgType"]?.ToString() ?? "website";
        var currentUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var defaultOgImage = $"{Context.Request.Scheme}://{Context.Request.Host}/favicon-512x512.png";
        var ogImage = ViewData["OgImage"]?.ToString() ?? defaultOgImage;
    }

    <title>@pageTitle - Read.me</title>

    <!-- Primary SEO Meta Tags -->
    <meta name="title" content="@ogTitle" />
    <meta name="description" content="@metaDesc" />
    <meta name="keywords" content="독서록, 서평, 독서 기록, 책 추천, 독서 일기, 책 속 한 문장, 북로그, 북리뷰, Read.me" />
    <meta name="author" content="Read.me" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@currentUrl" />

    <!-- Open Graph / KakaoTalk / Facebook Preview -->
    <meta property="og:type" content="@ogType" />
    <meta property="og:site_name" content="Read.me - 모두의 독서록" />
    <meta property="og:url" content="@currentUrl" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:description" content="@ogDesc" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:locale" content="ko_KR" />

    <!-- Twitter Card Preview -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@currentUrl" />
    <meta name="twitter:title" content="@ogTitle" />
    <meta name="twitter:description" content="@ogDesc" />
    <meta name="twitter:image" content="@ogImage" />

    <!-- Schema.org WebSite Structured Data -->
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "Read.me",
      "alternateName": "모두의 독서록",
      "url": "@($"{Context.Request.Scheme}://{Context.Request.Host}")",
      "description": "책 속의 문장과 생각을 기록하고 나누는 오픈 독서록 플랫폼",
      "potentialAction": {
        "@@type": "SearchAction",
        "target": "@($"{Context.Request.Scheme}://{Context.Request.Host}")/?query={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- Favicon & Mobile Touch Icons (Read.me Black & Purple Theme) -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
    <link rel="shortcut icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <meta name="theme-color" content="#090d16" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="badge brand-badge px-3 py-2 fs-6">
                        <i class="bi bi-book-half me-1 text-warning"></i> Read.me
                    </span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-chat-heart me-1"></i> 모두의 독서록
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Books" asp-action="Index">
                                <i class="bi bi-collection me-1"></i> 내 서재
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Books" asp-action="Create" class="btn btn-primary-gradient btn-sm px-3 py-2 shadow-sm fw-semibold">
                            <i class="bi bi-pencil-square me-1"></i> 독서록 쓰기
                        </a>
                        <button type="button" class="btn btn-glass btn-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#searchModal">
                            <i class="bi bi-search me-1"></i> 도서 검색
                        </button>

                        <!-- Kakao Login / User Profile -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var thumb = User.FindFirst("ThumbnailImage")?.Value ?? User.FindFirst("ProfileImage")?.Value;
                            <div class="dropdown ms-1">
                                <button class="btn btn-glass btn-sm dropdown-toggle d-flex align-items-center gap-2 py-1 px-2 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 9999px;">
                                    @if (!string.IsNullOrWhiteSpace(thumb))
                                    {
                                        <img src="@thumb" alt="@User.Identity.Name" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 28px; height: 28px; font-size: 0.75rem; background: linear-gradient(135deg, #7c3aed, #9333ea);">
                                            @(User.Identity.Name?[..1] ?? "K")
                                        </div>
                                    }
                                    <span class="text-white small fw-semibold d-none d-sm-inline">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2" style="border: 1px solid #ede9fe !important;">
                                    <li class="px-3 py-2">
                                        <span class="d-block fw-bold text-dark small">@User.Identity.Name</span>
                                        @{
                                            var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
                                        }
                                        @if (!string.IsNullOrWhiteSpace(userEmail))
                                        {
                                            <span class="d-block text-muted small" style="font-size: 0.78rem;"><i class="bi bi-envelope me-1"></i>@userEmail</span>
                                        }
                                        <span class="badge mt-1" style="font-size: 0.7rem; background-color: #f5f3ff; color: #7c3aed; border: 1px solid #ddd6fe;"><i class="bi bi-check-circle-fill me-1"></i>카카오 연동됨</span>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item small rounded-3 d-flex align-items-center gap-2 py-2" asp-controller="Books" asp-action="Index">
                                            <i class="bi bi-collection text-primary"></i> 내 서재 &amp; 독서록
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item small rounded-3 d-flex align-items-center gap-2 py-2 text-danger" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right"></i> 로그아웃
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-kakao btn-sm px-3 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm ms-1" title="카카오 계정으로 간편 로그인">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 3C6.477 3 2 6.477 2 10.767c0 2.76 1.83 5.187 4.593 6.556-.2.748-.726 2.709-.832 3.129-.133.523.19.516.4.377.165-.11 2.63-1.787 3.69-2.51.7.1 1.417.152 2.149.152 5.523 0 10-3.477 10-7.767C22 6.477 17.523 3 12 3z"/>
                                </svg>
                                <span>카카오 로그인</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 my-2">
        @if (TempData["AuthSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["AuthSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["AuthError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["AuthError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Global Book Search Modal (SaaS UI) -->
    <div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary p-2 rounded-3">
                            <i class="bi bi-search fs-5"></i>
                        </span>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-dark" id="searchModalLabel">도서 검색 및 서재 등록</h5>
                            <span class="text-muted small">카카오 도서 검색 API 실시간 연동</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Search Input Bar -->
                    <div class="mb-4">
                        <div class="input-group">
                            <input type="text" id="inputBookSearch" class="form-control search-input-box" 
                                   placeholder="책 제목, 저자, 키워드를 입력하세요 (예: 소크라테스, 클린 코드)" autofocus />
                            <button class="btn btn-search-pill ms-2" id="btnExecuteSearch" type="button">
                                <i class="bi bi-search me-1"></i> 검색
                            </button>
                        </div>
                    </div>

                    <!-- Loading State -->
                    <div id="searchLoading" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem;">
                            <span class="visually-hidden">검색 중...</span>
                        </div>
                        <p class="text-secondary fw-semibold mt-3 mb-0">도서를 검색하고 있습니다...</p>
                    </div>

                    <!-- Search Results -->
                    <div id="searchResultsList" class="row g-3">
                        <div class="col-12 text-center text-muted py-5">
                            <i class="bi bi-book-half fs-1 text-muted opacity-50"></i>
                            <h6 class="fw-bold mt-3 text-secondary">궁금한 책을 검색해 보세요</h6>
                            <p class="text-muted small mb-0">도서를 검색하고 [독서록 쓰기]를 바로 시작할 수 있습니다.</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3 px-4">
                    <span class="text-muted small me-auto"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>카카오 Open API로 도서 정보를 실시간 제공합니다.</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill" data-bs-dismiss="modal">닫기</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div id="appToast" class="toast align-items-center text-white bg-primary border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 12px;">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="appToastBody">
                    작업이 완료되었습니다.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <footer class="footer mt-auto py-4 bg-white border-top text-muted small">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <span>&copy; 2026 <strong class="text-dark">Read.me</strong> — A Modern Reading Journal built with ASP.NET Core &amp; Azure</span>
            <span>Powered by <a href="https://github.com/dh1180/Read.md" target="_blank" class="text-decoration-none text-primary"><i class="bi bi-github"></i> GitHub</a></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
