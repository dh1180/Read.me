<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Read.me</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="badge brand-badge px-3 py-2 fs-6">
                        <i class="bi bi-book-half me-1"></i> Read.me
                    </span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> 대시보드
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Books" asp-action="Index">
                                <i class="bi bi-collection me-1"></i> 내 서재
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-glass btn-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#searchModal">
                            <i class="bi bi-search me-1"></i> 도서 검색
                        </button>
                        <button type="button" class="btn btn-primary-gradient btn-sm px-3 py-2" id="btnExportReadmeHeader">
                            <i class="bi bi-markdown me-1"></i> README 내보내기
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 my-2">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Global Book Search Modal (SaaS UI) -->
    <div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary p-2 rounded-3">
                            <i class="bi bi-search fs-5"></i>
                        </span>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-dark" id="searchModalLabel">도서 검색 및 서재 등록</h5>
                            <span class="text-muted small">카카오 도서 검색 API 실시간 연동</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Search Input Bar -->
                    <div class="mb-4">
                        <div class="input-group">
                            <input type="text" id="inputBookSearch" class="form-control search-input-box" 
                                   placeholder="책 제목, 저자, 키워드를 입력하세요 (예: 소크라테스, 클린 코드)" autofocus />
                            <button class="btn btn-search-pill ms-2" id="btnExecuteSearch" type="button">
                                <i class="bi bi-search me-1"></i> 검색
                            </button>
                        </div>
                    </div>

                    <!-- Loading State -->
                    <div id="searchLoading" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem;">
                            <span class="visually-hidden">검색 중...</span>
                        </div>
                        <p class="text-secondary fw-semibold mt-3 mb-0">도서를 검색하고 있습니다...</p>
                    </div>

                    <!-- Search Results (No Horizontal Scroll) -->
                    <div id="searchResultsList" class="row g-3">
                        <div class="col-12 text-center text-muted py-5">
                            <i class="bi bi-book-half fs-1 text-muted opacity-50"></i>
                            <h6 class="fw-bold mt-3 text-secondary">궁금한 책을 검색해 보세요</h6>
                            <p class="text-muted small mb-0">원하는 도서의 [서재에 담기] 버튼을 누르면 즉시 내 서재에 등록됩니다.</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3 px-4">
                    <span class="text-muted small me-auto"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>비동기 Ajax로 부드럽게 등록됩니다.</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill" data-bs-dismiss="modal">닫기</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Export README Modal -->
    <div class="modal fade" id="exportReadmeModal" tabindex="-1" aria-labelledby="exportReadmeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary p-2 rounded-3"><i class="bi bi-github fs-5"></i></span>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-white" id="exportReadmeModalLabel">GitHub Profile용 README.md</h5>
                            <span class="text-white-50 small">내 독서 현황 마크다운 위젯</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        내 서재의 독서 진행률, 완독 목록, 필사 메모가 담긴 마크다운 코드입니다.
                        복사하여 본인의 <strong>GitHub Profile README</strong>나 블로그에 붙여넣어 보세요!
                    </p>
                    <div class="position-relative">
                        <textarea id="txtReadmeContent" class="form-control font-monospace small bg-light p-3" rows="13" readonly style="border-radius: 12px;"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light py-3 px-4">
                    <button type="button" class="btn btn-success rounded-pill px-4" id="btnCopyReadmeMarkdown">
                        <i class="bi bi-clipboard-check me-1"></i> 마크다운 클립보드 복사
                    </button>
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">닫기</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div id="appToast" class="toast align-items-center text-white bg-primary border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 12px;">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="appToastBody">
                    작업이 완료되었습니다.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <footer class="footer mt-auto py-4 bg-white border-top text-muted small">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <span>&copy; 2026 <strong class="text-dark">Read.me</strong> — A Modern Reading Journal built with ASP.NET Core &amp; Azure</span>
            <span>Powered by <a href="https://github.com/dh1180/Read.md" target="_blank" class="text-decoration-none text-primary"><i class="bi bi-github"></i> GitHub</a></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
