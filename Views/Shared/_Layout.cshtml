<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Read.me</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="badge brand-badge px-3 py-2 fs-6">
                        <i class="bi bi-book-half me-1 text-warning"></i> Read.me
                    </span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-chat-heart me-1"></i> 모두의 독서록
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Books" asp-action="Index">
                                <i class="bi bi-collection me-1"></i> 내 서재
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-primary-gradient btn-sm px-3 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#writeReviewModal">
                            <i class="bi bi-pencil-square me-1"></i> 독서록 쓰기
                        </button>
                        <button type="button" class="btn btn-glass btn-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#searchModal">
                            <i class="bi bi-search me-1"></i> 도서 검색
                        </button>
                        <button type="button" class="btn btn-outline-light btn-sm px-3 py-2" id="btnExportReadmeHeader">
                            <i class="bi bi-markdown me-1"></i> 내보내기
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4 my-2">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- 1. Write Book Review Modal (Ultra Easy Reading Log) -->
    <div class="modal fade" id="writeReviewModal" tabindex="-1" aria-labelledby="writeReviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header border-bottom pb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary p-2 rounded-3">
                            <i class="bi bi-pencil-square fs-5"></i>
                        </span>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-dark" id="writeReviewModalLabel">새 독서록 작성하기</h5>
                            <span class="text-muted small">읽은 책을 검색하고, 마음에 남은 생각과 문장을 편하게 기록해 보세요.</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Step 1: Book Selection -->
                    <div class="mb-4" id="sectionBookSearch">
                        <label class="form-label fw-bold small text-dark d-flex align-items-center gap-1">
                            <span class="badge bg-primary rounded-circle px-2 py-1 small">1</span> 어떤 책을 읽으셨나요? (카카오 도서 검색)
                        </label>
                        <div class="input-group mb-2">
                            <input type="text" id="inputReviewBookSearch" class="form-control" 
                                   placeholder="책 제목 또는 저자명을 입력하세요 (예: 소크라테스 익스프레스)" />
                            <button class="btn btn-primary px-3" id="btnExecuteReviewSearch" type="button">
                                <i class="bi bi-search me-1"></i> 검색
                            </button>
                        </div>
                        <div id="reviewSearchLoading" class="text-center py-3 d-none">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="text-muted small ms-2">도서를 찾고 있습니다...</span>
                        </div>
                        <!-- Compact Search Results List -->
                        <div id="reviewSearchResultsList" class="d-flex flex-column gap-2" style="max-height: 200px; overflow-y: auto;"></div>
                    </div>

                    <!-- Selected Book Card (Hidden initially) -->
                    <div id="selectedBookCard" class="d-none mb-4 p-3 bg-light rounded-4 border border-primary-subtle position-relative">
                        <div class="d-flex gap-3 align-items-center">
                            <img id="selectedBookCover" src="" alt="표지" class="rounded shadow-sm" style="width: 50px; height: 70px; object-fit: cover;" />
                            <div class="flex-grow-1 min-w-0">
                                <span class="badge bg-primary-subtle text-primary small mb-1">선택된 도서</span>
                                <h6 class="fw-bold mb-0 text-truncate text-dark" id="selectedBookTitle"></h6>
                                <p class="text-muted small mb-0 text-truncate" id="selectedBookMeta"></p>
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" id="btnChangeSelectedBook">
                                다른 책 선택
                            </button>
                        </div>
                        <!-- Hidden inputs for book data -->
                        <input type="hidden" id="hiddenIsbn" value="" />
                        <input type="hidden" id="hiddenTitle" value="" />
                        <input type="hidden" id="hiddenAuthor" value="" />
                        <input type="hidden" id="hiddenPublisher" value="" />
                        <input type="hidden" id="hiddenCoverUrl" value="" />
                        <input type="hidden" id="hiddenDesc" value="" />
                    </div>

                    <!-- Step 2: Reviewer Name & Star Rating -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="inputReviewer" class="form-label fw-bold small text-dark d-flex align-items-center gap-1">
                                <span class="badge bg-primary rounded-circle px-2 py-1 small">2</span> 작성자 닉네임
                            </label>
                            <input type="text" class="form-control rounded-3" id="inputReviewer" value="익명의 독서가" maxlength="30" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark d-flex align-items-center gap-1">
                                <span class="badge bg-primary rounded-circle px-2 py-1 small">3</span> 별점 주기
                            </label>
                            <div class="d-flex align-items-center gap-2 pt-1">
                                <div id="starRatingSelector" class="star-rating-picker fs-4 text-warning" style="cursor: pointer;">
                                    <i class="bi bi-star-fill star-pick active" data-value="1"></i>
                                    <i class="bi bi-star-fill star-pick active" data-value="2"></i>
                                    <i class="bi bi-star-fill star-pick active" data-value="3"></i>
                                    <i class="bi bi-star-fill star-pick active" data-value="4"></i>
                                    <i class="bi bi-star-fill star-pick active" data-value="5"></i>
                                </div>
                                <span class="fw-bold text-dark ms-2 small" id="lblRatingDescription">5.0점 (최고예요!)</span>
                                <input type="hidden" id="inputReviewRating" value="5" />
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Memorable Quote -->
                    <div class="mb-3">
                        <label for="inputReviewQuote" class="form-label fw-bold small text-dark d-flex align-items-center gap-1">
                            <span class="badge bg-primary rounded-circle px-2 py-1 small">4</span> 인상 깊은 한 문장 <span class="text-muted fw-normal">(선택)</span>
                        </label>
                        <textarea class="form-control rounded-3" id="inputReviewQuote" rows="2" 
                                  placeholder="책을 읽으며 밑줄 긋고 싶었던 문장이 있다면 적어보세요..."></textarea>
                    </div>

                    <!-- Step 4: Summary / Title -->
                    <div class="mb-3">
                        <label for="inputReviewSummary" class="form-label fw-bold small text-dark d-flex align-items-center gap-1">
                            <span class="badge bg-primary rounded-circle px-2 py-1 small">5</span> 한 줄 평 / 독서록 제목 <span class="text-muted fw-normal">(선택)</span>
                        </label>
                        <input type="text" class="form-control rounded-3" id="inputReviewSummary" 
                               placeholder="예: 삶의 태도를 유쾌하게 풀어낸 최고의 인생 책" maxlength="150" />
                    </div>

                    <!-- Step 5: Full Review Body -->
                    <div class="mb-3">
                        <label for="inputReviewContent" class="form-label fw-bold small text-dark d-flex align-items-center gap-1">
                            <span class="badge bg-primary rounded-circle px-2 py-1 small">6</span> 독서 감상평 <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control rounded-3" id="inputReviewContent" rows="5" 
                                  placeholder="책을 읽고 어떤 생각이 들었나요? 줄거리나 느낀 점을 자유롭게 적어보세요." required></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light border-0 py-3 px-4 rounded-bottom-4">
                    <span class="text-muted small me-auto"><i class="bi bi-check-circle-fill text-success me-1"></i>작성한 독서록은 모두의 피드에 공유됩니다.</span>
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">취소</button>
                    <button type="button" class="btn btn-primary-gradient rounded-pill px-4" id="btnSubmitReview">
                        <i class="bi bi-pencil-square me-1"></i> 독서록 등록하기
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Global Book Search Modal (SaaS UI) -->
    <div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary-subtle text-primary p-2 rounded-3">
                            <i class="bi bi-search fs-5"></i>
                        </span>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-dark" id="searchModalLabel">도서 검색 및 서재 등록</h5>
                            <span class="text-muted small">카카오 도서 검색 API 실시간 연동</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Search Input Bar -->
                    <div class="mb-4">
                        <div class="input-group">
                            <input type="text" id="inputBookSearch" class="form-control search-input-box" 
                                   placeholder="책 제목, 저자, 키워드를 입력하세요 (예: 소크라테스, 클린 코드)" autofocus />
                            <button class="btn btn-search-pill ms-2" id="btnExecuteSearch" type="button">
                                <i class="bi bi-search me-1"></i> 검색
                            </button>
                        </div>
                    </div>

                    <!-- Loading State -->
                    <div id="searchLoading" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary" role="status" style="width: 2.5rem; height: 2.5rem;">
                            <span class="visually-hidden">검색 중...</span>
                        </div>
                        <p class="text-secondary fw-semibold mt-3 mb-0">도서를 검색하고 있습니다...</p>
                    </div>

                    <!-- Search Results -->
                    <div id="searchResultsList" class="row g-3">
                        <div class="col-12 text-center text-muted py-5">
                            <i class="bi bi-book-half fs-1 text-muted opacity-50"></i>
                            <h6 class="fw-bold mt-3 text-secondary">궁금한 책을 검색해 보세요</h6>
                            <p class="text-muted small mb-0">도서를 검색하고 [독서록 쓰기]를 바로 시작할 수 있습니다.</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3 px-4">
                    <span class="text-muted small me-auto"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>카카오 Open API로 도서 정보를 실시간 제공합니다.</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-pill" data-bs-dismiss="modal">닫기</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Export README Modal -->
    <div class="modal fade" id="exportReadmeModal" tabindex="-1" aria-labelledby="exportReadmeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-dark text-white">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary p-2 rounded-3"><i class="bi bi-markdown fs-5"></i></span>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-white" id="exportReadmeModalLabel">독서록 마크다운 내보내기</h5>
                            <span class="text-white-50 small">내 독서 기록 및 추천 도서 마크다운</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        내 서재에 작성된 독서록과 감명 깊은 문장이 담긴 마크다운 코드입니다.
                        복사하여 개인 블로그나 GitHub README 등에 활용해 보세요!
                    </p>
                    <div class="position-relative">
                        <textarea id="txtReadmeContent" class="form-control font-monospace small bg-light p-3" rows="13" readonly style="border-radius: 12px;"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 bg-light py-3 px-4">
                    <button type="button" class="btn btn-success rounded-pill px-4" id="btnCopyReadmeMarkdown">
                        <i class="bi bi-clipboard-check me-1"></i> 마크다운 클립보드 복사
                    </button>
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">닫기</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div id="appToast" class="toast align-items-center text-white bg-primary border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 12px;">
            <div class="d-flex">
                <div class="toast-body fw-semibold" id="appToastBody">
                    작업이 완료되었습니다.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <footer class="footer mt-auto py-4 bg-white border-top text-muted small">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <span>&copy; 2026 <strong class="text-dark">Read.me</strong> — A Modern Reading Journal built with ASP.NET Core &amp; Azure</span>
            <span>Powered by <a href="https://github.com/dh1180/Read.md" target="_blank" class="text-decoration-none text-primary"><i class="bi bi-github"></i> GitHub</a></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
